<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <Target Name="CopyRawConverterToConsoleClient" AfterTargets="Build">
    <PropertyGroup>
      <ConsoleClientOutputDir>$(MSBuildProjectDirectory)\..\ConsoleClient\bin\$(Configuration)\</ConsoleClientOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <RawConverterOutputFiles Include="$(TargetDir)*.*" />
    </ItemGroup>
    <MakeDir Directories="$(ConsoleClientOutputDir)" />
    <Copy SourceFiles="@(RawConverterOutputFiles)" DestinationFolder="$(ConsoleClientOutputDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
